---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { categories, getCategory, isCategorySlug } from '../../utils/categories';
import { getArticlesByCategory } from '../../utils/articles';
import { breadcrumbSchema } from '../../utils/seo';

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.slug },
  }));
}

const { category: categoryParam } = Astro.params;

if (!categoryParam || !isCategorySlug(categoryParam)) {
  throw new Error(`Unknown category: ${categoryParam}`);
}

const category = getCategory(categoryParam);
if (!category) {
  throw new Error(`Unknown category: ${categoryParam}`);
}
const articles = await getArticlesByCategory(category.slug);

const crumbs = [
  { name: 'Home', href: '/' },
  { name: category.name, href: `/${category.slug}/` },
];
---

<BaseLayout
  title={`${category.name} Decor Ideas`}
  description={category.description}
  canonicalPath={`/${category.slug}/`}
  jsonLd={breadcrumbSchema(crumbs)}
>
  <Breadcrumbs items={crumbs} />

  <section class="border-b border-rule bg-sage-soft/30">
    <div class="container-editorial py-10 sm:py-14 md:py-20">
      <p class="section-label">Category</p>
      <h1 class="mt-2 font-display text-4xl text-ink sm:mt-3 sm:text-5xl md:text-6xl">{category.name}</h1>
      <p class="mt-4 max-w-2xl text-base text-ink-muted leading-relaxed sm:mt-5 sm:text-lg">
        {category.description}
      </p>
      <p class="mt-3 text-sm text-sage sm:mt-4">{category.pinDescription}</p>
    </div>
  </section>

  <section class="container-editorial py-10 sm:py-16">
    {
      articles.length > 0 ? (
        <div class="grid gap-8 sm:grid-cols-2 sm:gap-10 lg:grid-cols-3">
          {articles.map((article, index) => (
            <ArticleCard article={article} priority={index < 2} />
          ))}
        </div>
      ) : (
        <p class="text-ink-muted">New {category.name.toLowerCase()} stories are on the way.</p>
      )
    }
  </section>

  <NewsletterSignup
    heading={`Get ${category.name.toLowerCase()} ideas`}
    subheading="Occasional edits with room inspiration and product finds — no daily noise."
  />
</BaseLayout>
