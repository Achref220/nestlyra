---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { categories, SITE_NAME, SITE_TAGLINE } from '../utils/categories';
import { getFeaturedArticles, getLatestArticles, getArticlesByCategory } from '../utils/articles';

const latest = await getLatestArticles(6);
const popular = await getFeaturedArticles(4);
const categoryCounts = await Promise.all(
  categories.map(async (category) => ({
    category,
    count: (await getArticlesByCategory(category.slug)).length,
  })),
);
---

<BaseLayout
  title={SITE_NAME}
  description="Nestlyra is a home decor inspiration magazine for calm, elevated living — curated rooms, styling ideas, and thoughtfully chosen affiliate finds."
  canonicalPath="/"
  includeWebsiteSchema={true}
>
  <section class="relative overflow-hidden border-b border-rule">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgb(61_90_76_/_0.12),_transparent_55%)]"></div>
    <div
      class="container-editorial relative grid items-end gap-8 py-12 sm:gap-10 sm:py-16 md:min-h-[70vh] md:grid-cols-12 md:py-24"
    >
      <div class="min-w-0 md:col-span-8 animate-[fade-up_0.75s_ease-out]">
        <p class="section-label">Nestlyra</p>
        <h1 class="mt-3 font-display text-4xl leading-[1.08] text-ink sm:mt-4 sm:text-6xl md:text-7xl">
          Nestlyra
        </h1>
        <p class="mt-4 max-w-xl text-base text-ink-muted leading-relaxed sm:mt-6 sm:text-xl">
          {SITE_TAGLINE}. Editorial ideas for bedrooms, living rooms, and every quiet corner in between.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:mt-8 sm:flex-row sm:flex-wrap">
          <a href="/bedroom/" class="btn-primary btn-block-mobile text-center">Explore bedrooms</a>
          <a href="/search/" class="btn-secondary btn-block-mobile text-center">Search ideas</a>
        </div>
      </div>
      <div class="min-w-0 md:col-span-4 animate-[fade-in_0.9s_ease-out] md:pb-4">
        <p class="border-l border-sage pl-4 text-sm text-ink-muted leading-relaxed sm:pl-5 sm:text-base">
          Built for Google and Pinterest discovery — long-form room guides, tall visuals, and product picks worth living with.
        </p>
      </div>
    </div>
  </section>

  <section class="container-editorial py-12 sm:py-16 md:py-20" aria-labelledby="categories-heading">
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-end sm:justify-between sm:gap-4">
      <div class="min-w-0">
        <p class="section-label">Browse</p>
        <h2 id="categories-heading" class="section-heading mt-2 sm:mt-3">Featured categories</h2>
      </div>
      <a href="/search/" class="text-sm text-sage hover:text-sage-deep">Search all ideas</a>
    </div>
    <div class="mt-8 grid gap-3 sm:mt-10 sm:gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        categoryCounts.map(({ category, count }) => (
          <CategoryCard category={category} count={count} />
        ))
      }
    </div>
  </section>

  <section class="border-y border-rule bg-linen/60 py-12 sm:py-16 md:py-20" aria-labelledby="latest-heading">
    <div class="container-editorial">
      <p class="section-label">New</p>
      <h2 id="latest-heading" class="section-heading mt-2 sm:mt-3">Latest articles</h2>
      <div class="mt-8 grid gap-8 sm:mt-10 sm:grid-cols-2 sm:gap-10 lg:grid-cols-3">
        {latest.map((article, index) => <ArticleCard article={article} priority={index === 0} />)}
      </div>
    </div>
  </section>

  <section class="container-editorial py-12 sm:py-16 md:py-20" aria-labelledby="popular-heading">
    <p class="section-label">Reader favorites</p>
    <h2 id="popular-heading" class="section-heading mt-2 sm:mt-3">Popular ideas</h2>
    <div class="mt-8 grid gap-10 sm:mt-10 sm:gap-12">
      {
        popular.map((article, index) => (
          <ArticleCard article={article} variant="featured" priority={index === 0} />
        ))
      }
    </div>
  </section>

  <NewsletterSignup />
</BaseLayout>
