---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Contact Nestlyra for partnerships, feedback, or press inquiries."
  canonicalPath="/contact/"
>
  <article class="container-editorial max-w-3xl py-10 sm:py-14 md:py-20">
    <p class="section-label">Contact</p>
    <h1 class="mt-2 font-display text-4xl text-ink sm:mt-3 sm:text-5xl">Contact</h1>
    <div class="prose-editorial mt-8">
      <p>
        We read every note. For editorial feedback, brand partnerships, or affiliate inquiries,
        email us at
        <a href="mailto:hello@nestlyraliving.com">hello@nestlyraliving.com</a>.
      </p>
      <h2>What to include</h2>
      <ul>
        <li>Your name and brand or publication (if applicable)</li>
        <li>A short description of your request</li>
        <li>Relevant links or timelines</li>
      </ul>
      <p>
        We aim to respond within a few business days. Product seeding and paid placements are
        considered selectively when they align with Nestlyra’s editorial standards.
      </p>
    </div>
  </article>
</BaseLayout>
