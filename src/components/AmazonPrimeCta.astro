---
/** Amazon Associates tracking URL — do not alter. */
const PRIME_HREF = 'https://amzn.to/46Jysql';
---

<aside
  class="not-prose my-8 min-w-0 border border-rule bg-linen p-4 sm:my-10 sm:p-6"
  data-amazon-prime-cta
>
  <p class="section-label">Shopping note</p>
  <h2 class="mt-2 font-display text-xl text-ink sm:text-2xl">Shopping for your space?</h2>
  <p class="mt-2 max-w-xl text-sm text-ink-muted leading-relaxed sm:text-base">
    Amazon Prime may offer convenient delivery on eligible items.
  </p>
  <div class="mt-5">
    <a
      href={PRIME_HREF}
      class="btn-secondary btn-block-mobile text-center"
      rel="nofollow sponsored noopener noreferrer"
      target="_blank"
      aria-label="Learn more about Amazon Prime (paid link, opens in a new tab)"
    >
      Learn more →
    </a>
  </div>
  <p class="mt-3 text-xs leading-relaxed text-ink-muted/80">
    <span>(paid link)</span>
    {' '}
    Affiliate link.
    <a href="/affiliate-disclosure/" class="underline underline-offset-2 hover:text-sage">
      Disclosure
    </a>
  </p>
</aside>
