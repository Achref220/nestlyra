---
import { categories, SITE_NAME } from '../utils/categories';
---

<footer class="mt-16 border-t border-rule bg-sage-deep text-linen sm:mt-24">
  <div class="container-editorial grid gap-10 py-12 sm:gap-12 sm:py-16 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="font-display text-2xl sm:text-3xl">{SITE_NAME}</p>
      <p class="mt-3 max-w-sm text-sm text-linen/75 leading-relaxed sm:mt-4 sm:text-base">
        An editorial home for calm interiors, thoughtful styling, and products worth living with.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-8 sm:gap-10 md:col-span-7 md:grid-cols-2">
      <div>
        <p class="section-label text-linen/60">Explore</p>
        <ul class="mt-3 space-y-1 sm:mt-4 sm:space-y-2">
          {
            categories.map((category) => (
              <li>
                <a
                  href={`/${category.slug}/`}
                  class="inline-flex min-h-10 items-center text-sm text-linen/85 hover:text-linen sm:text-base"
                >
                  {category.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="section-label text-linen/60">Company</p>
        <ul class="mt-3 space-y-1 sm:mt-4 sm:space-y-2">
          <li>
            <a href="/about/" class="inline-flex min-h-10 items-center text-sm text-linen/85 hover:text-linen sm:text-base">
              About
            </a>
          </li>
          <li>
            <a href="/contact/" class="inline-flex min-h-10 items-center text-sm text-linen/85 hover:text-linen sm:text-base">
              Contact
            </a>
          </li>
          <li>
            <a
              href="/affiliate-disclosure/"
              class="inline-flex min-h-10 items-center text-sm text-linen/85 hover:text-linen sm:text-base"
            >
              Affiliate Disclosure
            </a>
          </li>
          <li>
            <a href="/privacy/" class="inline-flex min-h-10 items-center text-sm text-linen/85 hover:text-linen sm:text-base">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms/" class="inline-flex min-h-10 items-center text-sm text-linen/85 hover:text-linen sm:text-base">
              Terms of Use
            </a>
          </li>
          <li>
            <a href="/search/" class="inline-flex min-h-10 items-center text-sm text-linen/85 hover:text-linen sm:text-base">
              Search
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-linen/10">
    <div
      class="container-editorial flex flex-col gap-2 py-5 text-xs text-linen/55 sm:flex-row sm:justify-between sm:py-6 sm:text-sm"
    >
      <p>&copy; {new Date().getFullYear()} {SITE_NAME}. All rights reserved.</p>
      <p class="text-linen/75">
        Some links are affiliate links.
        <a href="/affiliate-disclosure/" class="underline underline-offset-2 hover:text-linen">
          See our disclosure
        </a>
        for details.
      </p>
    </div>
  </div>
</footer>
