---
import type { BreadcrumbItem } from '../utils/seo';

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="container-editorial py-3 sm:py-5">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-muted sm:text-sm">
    {
      items.map((item, index) => (
        <li class="flex max-w-full items-center gap-2">
          {index > 0 && <span aria-hidden="true" class="shrink-0 text-rule">/</span>}
          {index === items.length - 1 ? (
            <span aria-current="page" class="line-clamp-1 text-ink">
              {item.name}
            </span>
          ) : (
            <a href={item.href} class="shrink-0 hover:text-sage">
              {item.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
