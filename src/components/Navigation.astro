---
import { categories } from '../utils/categories';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<nav aria-label="Categories" class:list={[compact ? 'flex flex-wrap gap-3' : 'grid gap-3 sm:grid-cols-2 lg:grid-cols-4']}>
  {
    categories.map((category) => (
      <a
        href={`/${category.slug}/`}
        class:list={[
          compact
            ? 'border border-rule px-4 py-2 text-sm text-ink-muted hover:border-sage hover:text-sage'
            : 'group border-b border-rule pb-3 hover:border-sage',
        ]}
      >
        {!compact && <span class="section-label">{category.name}</span>}
        {compact ? (
          category.name
        ) : (
          <span class="mt-2 block font-display text-xl text-ink group-hover:text-sage">{category.name}</span>
        )}
      </a>
    ))
  }
</nav>
