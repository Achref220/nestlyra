---
interface Props {
  heading?: string;
  subheading?: string;
}

const {
  heading = 'Ideas worth pinning',
  subheading = 'Room styling notes, seasonal edits, and product finds — delivered occasionally.',
} = Astro.props;

const endpoint = (import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT ?? '').trim();
---

{
  endpoint ? (
    <section class="border-y border-rule bg-sage-soft/50" aria-labelledby="newsletter-heading">
      <div class="container-editorial grid gap-6 py-12 sm:gap-8 sm:py-16 md:grid-cols-2 md:items-end">
        <div class="min-w-0">
          <p class="section-label">Newsletter</p>
          <h2
            id="newsletter-heading"
            class="mt-2 font-display text-3xl text-ink sm:mt-3 sm:text-4xl md:text-5xl"
          >
            {heading}
          </h2>
          <p class="mt-3 max-w-md text-sm text-ink-muted leading-relaxed sm:mt-4 sm:text-base">
            {subheading}
          </p>
        </div>

        <div class="min-w-0">
          <form id="newsletter-form" class="flex flex-col gap-3 sm:flex-row" data-endpoint={endpoint}>
            <label class="sr-only" for="newsletter-email">Email address</label>
            <input
              id="newsletter-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              class="min-h-11 w-full border border-rule bg-linen px-4 py-3 text-base text-ink placeholder:text-ink-muted/50 focus:border-sage"
            />
            <button type="submit" class="btn-primary btn-block-mobile shrink-0">Subscribe</button>
          </form>
          <p id="newsletter-status" class="mt-3 text-sm text-ink-muted" role="status" aria-live="polite"></p>
        </div>
      </div>
    </section>
  ) : null
}

{
  endpoint && (
    <script>
      const form = document.getElementById('newsletter-form');
      const status = document.getElementById('newsletter-status');
      if (form instanceof HTMLFormElement && status) {
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const endpointUrl = form.dataset.endpoint;
          if (!endpointUrl) return;

          const emailInput = form.elements.namedItem('email');
          if (!(emailInput instanceof HTMLInputElement)) return;

          status.textContent = 'Subscribing…';
          try {
            const response = await fetch(endpointUrl, {
              method: 'POST',
              headers: {
                Accept: 'application/json',
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({ email: emailInput.value }),
            });
            if (!response.ok) throw new Error('Request failed');
            status.textContent = 'You are on the list. Welcome.';
            form.reset();
          } catch {
            status.textContent = 'Something went wrong. Please try again later.';
          }
        });
      }
    </script>
  )
}
