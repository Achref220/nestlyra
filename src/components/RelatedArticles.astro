---
import ArticleCard from './ArticleCard.astro';
import type { ArticleEntry } from '../utils/articles';

interface Props {
  articles: ArticleEntry[];
  heading?: string;
}

const { articles, heading = 'Related ideas' } = Astro.props;
---

{
  articles.length > 0 && (
    <section class="container-editorial py-12 sm:py-16" aria-labelledby="related-heading">
      <p class="section-label">Keep exploring</p>
      <h2 id="related-heading" class="section-heading mt-2 sm:mt-3">
        {heading}
      </h2>
      <div class="mt-8 grid gap-8 sm:mt-10 sm:grid-cols-2 sm:gap-10 lg:grid-cols-3">
        {articles.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    </section>
  )
}
