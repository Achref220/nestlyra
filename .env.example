# Public site URL used for canonicals, sitemap, and Open Graph
PUBLIC_SITE_URL=https://nestlyraliving.com

# Newsletter form endpoint (Formspree, Buttondown, Mailchimp, etc.)
# Leave empty to hide the newsletter block entirely
PUBLIC_NEWSLETTER_ENDPOINT=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Leave empty to disable analytics
PUBLIC_GA_MEASUREMENT_ID=
